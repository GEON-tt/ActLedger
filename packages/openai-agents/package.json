  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@actledger/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@openai/agents": "^0.20.0"
  },
  "devDependencies": {
    "@openai/agents": "0.20.0",
    "zod": "^4.6.7"
  }
}
