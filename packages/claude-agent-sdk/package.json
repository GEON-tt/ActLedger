  "description": "ActLedger adapter for the Claude Agent SDK: canUseTool and PostToolUse hooks backed by a ToolGate",
  "license": "Apache-2.0",
  "author": "ActLedger contributors",
  "keywords": ["actledger", "claude", "claude-agent-sdk", "agent", "approval", "ledger"],
  "repository": {
    "type": "git",
