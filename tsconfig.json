{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@actledger/core": ["./packages/core/src/index.ts"],
      "@actledger/sdk": ["./packages/sdk/src/index.ts"],
      "@actledger/sdk/webhook": ["./packages/sdk/src/webhook.ts"],
      "@actledger/mcp-proxy": ["./packages/mcp-proxy/src/index.ts"],
      "@actledger/claude-agent-sdk": ["./packages/claude-agent-sdk/src/index.ts"],
      "@actledger/openai-agents": ["./packages/openai-agents/src/index.ts"],
      "@actledger/cli/serve": ["./packages/cli/src/serve/server.ts"],
      "@actledger/cli/console": ["./packages/cli/src/serve/console.ts"],
      "@actledger/server": ["./packages/server/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "examples/**/*.ts",
    "vitest.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
